/*
 * Stock Totem keymap (GEIGEIGEIST layout: BASE / NAV / SYM / ADJ).
 * Do not #undef ZMK_BEHAVIORS_KEEP_ALL — the Studio snippet sets it so the
 * palette includes &bootloader and the rest. Stripping that is why a Studio
 * pinky→bootloader binding died after the last flash.
 */
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

#define BASE 0
#define NAV  1
#define SYM  2
#define ADJ  3

&mt {
    flavor = "tap-preferred";
    tapping-term-ms = <170>;
    quick-tap-ms = <100>;
};

/ {
    combos {
        compatible = "zmk,combos";
        combo_esc {
            timeout-ms = <50>;
            key-positions = <0 1>;
            bindings = <&kp ESC>;
        };
#ifdef CONFIG_ZMK_STUDIO
        combo_studio_unlock {
            timeout-ms = <80>;
            key-positions = <0 4>;
            bindings = <&studio_unlock>;
        };
#endif
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "BASE";
            bindings = <
                &kp Q           &kp W           &kp F           &kp P           &kp G               &kp J           &kp L           &kp U           &kp Y           &kp SEMI
                &mt LGUI A      &mt LALT R      &mt LCTRL S     &mt LSHFT T     &kp D               &kp H           &mt RSHFT N     &mt RCTRL E     &mt RALT I      &mt RGUI O
     &kp Q      &kp Z           &kp X           &kp C           &kp V           &kp B               &kp K           &kp M           &kp COMMA       &kp DOT         &kp FSLH        &kp BSLH
                                         &kp DEL         &lt NAV TAB         &kp SPACE       &kp RET         &lt SYM ESC     &kp BSPC
            >;
        };

        nav_layer {
            display-name = "NAV";
            bindings = <
                &kp ESC         &bt BT_CLR      &kp UP          &kp EQUAL       &kp LBRC            &kp RBRC        &kp N7          &kp N8          &kp N9          &kp PLUS
                &kp LSHFT       &kp LEFT        &kp DOWN        &kp RIGHT       &kp LBKT            &kp RBKT        &kp N4          &kp N5          &kp N6          &kp MINUS
                &trans          &kp DEL         &kp PG_UP       &kp CAPS        &kp PG_DN           &kp LPAR        &kp RPAR        &kp N1          &kp N2          &kp N3          &kp STAR        &trans
                                                                &trans          &trans              &trans          &mo ADJ         &kp N0          &trans
            >;
        };

        sym_layer {
            display-name = "SYM";
            bindings = <
                &kp EXCL        &kp AT          &kp HASH        &kp DLLR        &kp PRCNT           &kp CARET       &kp AMPS        &trans          &kp SQT         &kp DQT
                &trans          &trans          &trans          &trans          &trans              &kp C_MUTE      &trans          &trans          &trans          &trans
                &trans          &trans          &trans          &trans          &trans              &trans          &kp C_VOL_DN    &kp C_VOL_UP    &kp C_PREV      &kp C_NEXT      &kp BSLH        &trans
                                                                &trans          &trans              &mo ADJ         &trans          &kp C_PP        &trans
            >;
        };

        adj_layer {
            display-name = "ADJ";
            bindings = <
                &sys_reset      &bt BT_CLR      &out OUT_TOG    &trans          &trans              &trans          &kp F7          &kp F8          &kp F9          &kp F12
                &bootloader     &bt BT_NXT      &trans          &trans          &trans              &trans          &kp F4          &kp F5          &kp F6          &kp F11
                &trans          &trans          &bt BT_PRV      &trans          &trans              &trans          &trans          &kp F1          &kp F2          &kp F3          &kp F10         &trans
                                                                &trans          &trans              &trans          &trans          &trans          &trans
            >;
        };
    };
};
